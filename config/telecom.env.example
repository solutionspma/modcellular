# Build Pack HI - Environment Configuration

# Telecom Provider (Telnyx - Primary)
TELNYX_API_KEY=your_telnyx_api_key_here
TELNYX_PUBLIC_KEY=your_telnyx_public_key_here
TELNYX_CONNECTION_ID=your_connection_id
TELNYX_MESSAGING_PROFILE_ID=your_messaging_profile_id
TELNYX_WEBHOOK_SECRET=your_webhook_secret

# SIP Configuration
SIP_DOMAIN=sip.modcellular.network
SIP_USERNAME=mod_sip_user
SIP_PASSWORD=secure_sip_password
TURN_PASSWORD=secure_turn_password

# Billing (Stripe)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Voicemail Storage (Supabase)
VOICEMAIL_BUCKET=mod-cellular-voicemails
VOICEMAIL_CDN_URL=https://yourstorage.supabase.co/storage/v1/object/public/voicemails

# Transcription (OpenAI)
OPENAI_API_KEY=sk-...

# API URLs
API_URL=https://api.modcellular.network
PORTING_WEBHOOK_URL=https://api.modcellular.network/webhooks/telnyx/porting

# MODX Token Pricing
MODX_USD_PRICE=0.05

# Features
HOLD_MUSIC_URL=https://cdn.modcellular.network/audio/hold-music.mp3
